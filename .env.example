# Required to start the local gateway. Use a random value of at least 16 characters.
SEMANTIC_GATEWAY_TOKEN=replace-with-a-long-random-local-token
SEMANTIC_GATEWAY_PORT=8787

# Configure only the provider you intend to use.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Optional prompt-intelligence stage. It is disabled by default, so no raw prompt
# is sent to a third-party model unless you select a provider explicitly.
SEMANTIC_INTELLIGENCE_PROVIDER=disabled
# SEMANTIC_INTELLIGENCE_MODEL=
# SEMANTIC_INTELLIGENCE_INSTRUCTIONS_PATH=.semantic-gateway/prompt-intelligence-instructions.json

# Option 1: OpenAI Responses API (uses OPENAI_API_KEY above).
# SEMANTIC_INTELLIGENCE_PROVIDER=openai
# SEMANTIC_INTELLIGENCE_MODEL=gpt-5-mini

# Option 2: Gemini Interactions API.
# SEMANTIC_INTELLIGENCE_PROVIDER=gemini
# GEMINI_API_KEY=
# SEMANTIC_INTELLIGENCE_MODEL=gemini-2.5-flash-lite
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Option 3: any OpenAI-compatible gateway/provider.
# SEMANTIC_INTELLIGENCE_PROVIDER=openai-compatible
# SEMANTIC_INTELLIGENCE_API_KEY=
# SEMANTIC_INTELLIGENCE_BASE_URL=https://your-provider.example/v1
# SEMANTIC_INTELLIGENCE_MODEL=your-model-name
